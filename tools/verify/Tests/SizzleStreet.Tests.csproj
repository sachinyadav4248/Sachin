<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the Unity edit-mode tests headlessly.

    These are the same source files the Unity Test Runner compiles. Running them here means
    the economy, the save system and the production chain are verified on every push without
    a Unity licence in CI, and long before anyone opens the editor.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>SizzleStreet.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Runtime/SizzleStreet.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../unity/Assets/_Project/Scripts/Tests/EditMode/**/*.cs" />
  </ItemGroup>

</Project>
